    <gazebo reference="camera_arm_link">
      <material>Gazebo/Orange</material>
    </gazebo>
    <gazebo reference="fork_link_L">
      <material>Gazebo/Orange</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.01</maxVel>
    </gazebo>
    <gazebo reference="fork_link_R">
