<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="desk">
  <xacro:include filename="$(find arm_description)/urdf/desk.urdf.xacro" />
  <xacro:desk />

  <gazebo>
    <static>true</static>
  </gazebo>
  <gazebo reference="desk_link">
  <material>Gazebo/white</material>
  </gazebo>

  <gazebo reference="place_1_link">
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo reference="place_2_link">
    <material>Gazebo/Green</material>
  </gazebo>

  <gazebo reference="place_3_link">
    <material>Gazebo/Yellow</material>
  </gazebo>

  <gazebo reference="place_4_link">
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference="bolck_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="s_1_L">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="s_2_L">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="s_3_L">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="s_4_L">
    <material>Gazebo/Blue</material>
  </gazebo>
</robot>
